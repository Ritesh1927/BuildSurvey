enum AttendanceSource {
  // Marked in person from the office attendance page (photo + office geofence).
  OFFICE
  // Auto-marked because the user checked in to a Survey or Site Visit that
  // day - they were doing field work, not skipping the office. No photo is
  // stored for these (see FIELD_VISIT handling in src/lib/attendance.ts).
  FIELD_VISIT
}

model Attendance {
  id             String           @id @default(uuid())
  // The calendar day this record is for (stored at UTC midnight) — paired
  // with userId in a unique constraint so an employee can only mark
  // attendance once per day.
  date           DateTime
  markedAt       DateTime         @default(now())
  latitude       Float
  longitude      Float
  distanceMeters Int
  // Nulled out by the daily cleanup cron once the record passes 30 days
  // old — the GPS/date/distance history is kept indefinitely, only the
  // photo itself is time-limited. Always null for FIELD_VISIT records.
  photoUrl       String?
  source         AttendanceSource @default(OFFICE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  createdBy      String?
  updatedBy      String?
  isDeleted      Boolean          @default(false)
  version        Int              @default(1)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId])
  @@index([date])
}

// Ongoing post-survey-approval site supervision - an Engineer checks in/out
// each visit to a project (unlike Survey, which is a one-time record, this
// repeats across the project's working days). Both check-in and check-out
// are hard-blocked off-site, unlike Survey's check-in which only flags it -
// this is a deliberate difference: an off-site "present" record here
// wouldn't mean anything.
model SiteVisit {
  id                String    @id @default(uuid())
  checkedInAt       DateTime  @default(now())
  checkedOutAt      DateTime?
  checkInLatitude   Float
  checkInLongitude  Float
  checkInPhotoUrl   String
  checkOutLatitude  Float?
  checkOutLongitude Float?
  checkOutPhotoUrl  String?
  // Required before checkout - the engineer's own account of the day's
  // work, replacing Survey's checklist (which doesn't fit a repeating,
  // free-form supervision visit the way it fits a one-time inspection).
  workSummary       String?   @db.Text
  // The calendar day (UTC midnight) this visit belongs to, set at check-in -
  // paired with projectId+engineerId in a unique constraint so an engineer
  // can only visit a given project once per day, and so checkout can detect
  // a stale (past-midnight) check-in instead of closing it out late.
  visitDate         DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdBy         String?
  updatedBy         String?
  isDeleted         Boolean   @default(false)
  version           Int       @default(1)

  projectId  String
  project    Project @relation(fields: [projectId], references: [id])
  engineerId String
  engineer   User    @relation(fields: [engineerId], references: [id])

  @@unique([projectId, engineerId, visitDate])
  @@index([projectId])
  @@index([engineerId])
  @@index([checkedInAt])
}

// Org-wide ad-hoc holidays (festivals, company off-days) - one row per
// specific date. The recurring weekly rule (e.g. "Sundays are always off")
// is a simple Setting key instead, since it's a single value, not a list.
model Holiday {
  id        String   @id @default(uuid())
  date      DateTime
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean  @default(false)

  @@unique([date])
  @@index([date])
}


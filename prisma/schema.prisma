generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- ENUMS ---

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  ENGINEER
  SURVEYOR
  CLIENT
  ACCOUNTANT
  // Legacy-column placeholder for a user on a genuinely custom (non-system)
  // Role - see users/route.ts. Deliberately not ENGINEER/SURVEYOR/etc, so
  // it never spuriously matches an identity check (role === 'ENGINEER',
  // hasRole(user, 'ENGINEER')) that a real Engineer-flavored user would
  // pass. roleId is the actual source of truth for a custom-role user.
  CUSTOM
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum ProjectType {
  RESIDENTIAL
  COMMERCIAL
  INDUSTRIAL
  INFRASTRUCTURE
  INTERIOR
  MEP
  RENOVATION
}

enum SurveyStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
}

enum SurveyType {
  INITIAL
  DETAILED
  FOLLOW_UP
  FINAL
  AS_BUILT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUIRED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum DocumentType {
  DRAWING
  SPECIFICATION
  CONTRACT
  INVOICE
  REPORT
  CORRESPONDENCE
  OTHER
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  CANCELLED
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  CANCELLED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

enum MediaType {
  PHOTO
  VIDEO
  VOICE_NOTE
  DRAWING
  SKETCH
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WorkflowStatus {
  DRAFT
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  BLOCKED
}

enum ActivityType {
  CREATED
  UPDATED
  DELETED
  APPROVED
  REJECTED
  ASSIGNED
  COMMENTED
  UPLOADED
}

// --- MODELS ---

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  role          UserRole  @default(ENGINEER)
  // Optional dual-capability role (ENGINEER or SURVEYOR only, enforced at
  // the API layer) - additive, not a replacement: it grants the other
  // role's specific eligibility (site-visit check-in, leading a project,
  // assignment lists) on top of whatever `role` already allows, rather
  // than switching the user's whole identity/scoping to it.
  secondaryRole UserRole?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  updatedBy     String?
  isDeleted     Boolean   @default(false)
  version       Int       @default(1)

  ledProjects               Project[]          @relation("LedProjects")
  managedProjects           Project[]          @relation("ManagedProjects")
  assignedSurveys           Survey[]           @relation("SurveyEngineer")
  auditLogs                 AuditLog[]
  notifications             Notification[]
  signatures                DigitalSignature[]
  workflowSteps             WorkflowStep[]     @relation("WorkflowStepAssignee")
  approvalsRequested        Approval[]         @relation("ApprovalRequester")
  approvalsGiven            Approval[]         @relation("ApprovalApprover")
  activities                Activity[]
  reports                   Report[]           @relation("ReportGenerator")
  documentsUploaded         Document[]         @relation("DocumentUploader")
  gpsTracking               GpsTracking[]
  riskAssessmentsIdentified RiskAssessment[]   @relation("RiskIdentifier")
  changeOrdersRequested     ChangeOrder[]      @relation("COResuestedBy")
  changeOrdersApproved      ChangeOrder[]      @relation("COApprovedBy")
  leadsAssigned             Lead[]             @relation("LeadAssignee")
  attendanceRecords         Attendance[]
  siteVisits                SiteVisit[]

  // Links a CLIENT-role login to the Client company they represent. Null
  // for every other role. A direct FK rather than a join table — one
  // client-side login realistically belongs to exactly one client company;
  // a many-to-many would be unused complexity for a relationship that is
  // 1:many in practice (one Client can have several contacts/logins).
  clientId String?
  client   Client? @relation("ClientUsers", fields: [clientId], references: [id])

  // New dynamic RBAC system (see Role/Permission below) - nullable and
  // additive alongside `role`/`secondaryRole` above, which remain the
  // source of truth every existing permission check reads until routes
  // are migrated over. Backfilled from role/secondaryRole by
  // scripts/seed-roles-permissions.ts once this lands. Kept as a
  // separate roleRef/secondaryRoleRef relation name (not `role`) so
  // this change touches zero existing call sites.
  roleId           String?
  roleRef          Role?   @relation("UserPrimaryRole", fields: [roleId], references: [id])
  secondaryRoleId  String?
  secondaryRoleRef Role?   @relation("UserSecondaryRole", fields: [secondaryRoleId], references: [id])

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([clientId])
  @@index([roleId])
}

// --- DYNAMIC RBAC (Role / Permission) ---
//
// Permission rows are a fixed catalog seeded by
// scripts/seed-roles-permissions.ts, each corresponding to an actual
// requirePermission() check somewhere in the app - you can't grant access
// to something no code checks for. Role rows are fully dynamic: the 7
// pre-existing roles (SUPER_ADMIN, ADMIN, ...) are seeded as isSystem
// rows with the exact permission set that reproduces their current
// access, and an admin can create additional custom Role rows (or edit
// any existing role's permissions, system or custom) via the Roles &
// Permissions panel.

model Role {
  id          String   @id @default(uuid())
  // Stable identifier, uppercase-snake for the 7 seeded system roles
  // (matches the legacy UserRole enum values) or slugified from `name`
  // for custom roles. Nothing outside this table's own seed data keys
  // off this - renaming `name` never breaks a permission check.
  key         String   @unique
  name        String
  description String?
  // System roles can have their permissions edited but not their key,
  // and can't be deleted - enforced in /api/roles, not here.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?

  permissions    RolePermission[]
  primaryUsers   User[]           @relation("UserPrimaryRole")
  secondaryUsers User[]           @relation("UserSecondaryRole")

  @@index([key])
}

model Permission {
  id       String @id @default(uuid())
  // e.g. "leads:read", "projects:write:own" - see the seed script for
  // the full catalog and which requirePermission() call each one gates.
  key      String @unique
  resource String
  action   String
  label    String
  category String

  roles RolePermission[]

  @@index([resource])
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model Client {
  id            String   @id @default(uuid())
  companyName   String
  contactPerson String
  // Uniqueness among active clients is enforced by a partial unique index
  // (WHERE "isDeleted" = false) created directly in the database — not a
  // plain @unique, since that would apply across soft-deleted rows too
  // and block legitimate email reuse. Prisma's schema DSL has no partial-
  // index syntax, so this constraint is intentionally invisible here;
  // do not add @unique back, and do not let `prisma db push` "fix" this.
  email         String
  phone         String
  address       String?
  city          String?
  state         String?
  zipCode       String?
  country       String?
  gstNumber     String?
  panNumber     String?
  website       String?
  clientType    String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  updatedBy     String?
  isDeleted     Boolean  @default(false)
  version       Int      @default(1)

  projects Project[]
  leads    Lead[]
  users    User[]    @relation("ClientUsers")

  @@index([companyName])
  @@index([email])
}

model Lead {
  id             String     @id @default(uuid())
  name           String
  email          String?
  phone          String?
  company        String?
  source         String?
  status         LeadStatus @default(NEW)
  priority       Priority   @default(MEDIUM)
  estimatedValue Float?
  notes          String?
  convertedAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  createdBy      String?
  updatedBy      String?
  isDeleted      Boolean    @default(false)
  version        Int        @default(1)

  clientId     String?
  client       Client? @relation(fields: [clientId], references: [id])
  assignedToId String?
  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id])

  @@index([status])
  @@index([assignedToId])
  @@index([clientId])
  @@index([createdAt])
}

model Project {
  id          String        @id @default(uuid())
  name        String
  code        String        @unique
  description String?
  type        ProjectType   @default(RESIDENTIAL)
  status      ProjectStatus @default(PLANNING)
  startDate   DateTime?
  endDate     DateTime?
  budget      Float?
  actualCost  Float?        @default(0)
  address     String?
  city        String?
  state       String?
  latitude    Float?
  longitude   Float?
  area        Float?
  floors      Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean       @default(false)
  version     Int           @default(1)

  clientId   String
  client     Client  @relation(fields: [clientId], references: [id])
  managerId  String?
  manager    User?   @relation("ManagedProjects", fields: [managerId], references: [id])
  leadUserId String?
  leadUser   User?   @relation("LedProjects", fields: [leadUserId], references: [id])

  surveys         Survey[]
  boqItems        BOQItem[]
  costEstimations CostEstimation[]
  quotations      Quotation[]
  documents       Document[]
  workflows       Workflow[]
  activities      Activity[]
  reports         Report[]
  gpsTracking     GpsTracking[]
  meetings        Meeting[]
  changeOrders    ChangeOrder[]
  siteVisits      SiteVisit[]

  @@index([code])
  @@index([clientId])
  @@index([managerId])
  @@index([leadUserId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model Survey {
  id               String       @id @default(uuid())
  title            String
  description      String?
  type             SurveyType   @default(INITIAL)
  status           SurveyStatus @default(ASSIGNED)
  scheduledDate    DateTime?
  completedDate    DateTime?
  gpsLatitude      Float?
  gpsLongitude     Float?
  weatherCondition String?
  siteCondition    String?
  accessDetails    String?
  notes            String?
  checkedInAt      DateTime?
  checkedOutAt     DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  createdBy        String?
  updatedBy        String?
  isDeleted        Boolean      @default(false)
  version          Int          @default(1)

  projectId  String
  project    Project @relation(fields: [projectId], references: [id])
  engineerId String?
  engineer   User?   @relation("SurveyEngineer", fields: [engineerId], references: [id])

  checklistItems       SurveyChecklistItem[]
  photos               Photo[]
  videos               Video[]
  voiceNotes           VoiceNote[]
  sketches             Sketch[]
  measurements         Measurement[]
  riskAssessments      RiskAssessment[]
  materialRequirements MaterialRequirement[]

  @@index([projectId])
  @@index([engineerId])
  @@index([status])
  @@index([type])
  @@index([scheduledDate])
  @@index([createdAt])
}

model SurveyChecklistItem {
  id          String   @id @default(uuid())
  category    String
  item        String
  isCompleted Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean  @default(false)
  version     Int      @default(1)

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@index([isCompleted])
}

model Photo {
  id        String    @id @default(uuid())
  url       String
  filename  String
  caption   String?
  latitude  Float?
  longitude Float?
  takenAt   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  version   Int       @default(1)

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@index([takenAt])
}

model Video {
  id        String   @id @default(uuid())
  url       String
  filename  String
  caption   String?
  duration  Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean  @default(false)
  version   Int      @default(1)

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
}

model VoiceNote {
  id            String   @id @default(uuid())
  url           String
  filename      String
  duration      Float?
  transcription String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  updatedBy     String?
  isDeleted     Boolean  @default(false)
  version       Int      @default(1)

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
}

model Sketch {
  id        String   @id @default(uuid())
  title     String
  data      Json?
  url       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean  @default(false)
  version   Int      @default(1)

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
}

model Measurement {
  id          String   @id @default(uuid())
  category    String
  description String?
  length      Float?
  width       Float?
  height      Float?
  area        Float?
  volume      Float?
  unit        String   @default("m")
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean  @default(false)
  version     Int      @default(1)

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@index([category])
}

model RiskAssessment {
  id          String    @id @default(uuid())
  title       String
  description String
  level       RiskLevel @default(MEDIUM)
  mitigation  String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean   @default(false)
  version     Int       @default(1)

  surveyId       String
  survey         Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  identifiedById String
  identifiedBy   User   @relation("RiskIdentifier", fields: [identifiedById], references: [id])

  @@index([surveyId])
  @@index([level])
  @@index([identifiedById])
}

model MaterialRequirement {
  id            String   @id @default(uuid())
  materialName  String
  specification String?
  quantity      Float
  unit          String
  estimatedCost Float?
  supplier      String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  updatedBy     String?
  isDeleted     Boolean  @default(false)
  version       Int      @default(1)

  surveyId String
  survey   Survey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@index([surveyId])
  @@index([materialName])
}

model BOQItem {
  id           String   @id @default(uuid())
  serialNumber Int
  description  String
  category     String
  unit         String
  quantity     Float
  unitRate     Float
  amount       Float
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?
  isDeleted    Boolean  @default(false)
  version      Int      @default(1)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([category])
  @@index([serialNumber])
}

model CostEstimation {
  id              String   @id @default(uuid())
  category        String
  description     String?
  estimatedAmount Float
  actualAmount    Float?
  variance        Float?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  isDeleted       Boolean  @default(false)
  version         Int      @default(1)

  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([category])
}

model Quotation {
  id              String          @id @default(uuid())
  quotationNumber String          @unique
  title           String
  totalAmount     Float
  taxAmount       Float           @default(0)
  discountAmount  Float           @default(0)
  grandTotal      Float
  validUntil      DateTime?
  terms           String?
  notes           String?
  // Where this quotation is in the sales lifecycle (draft -> sent ->
  // accepted/rejected). Separate from `status`, which tracks payment
  // collection and is only meaningful once quotationStatus = ACCEPTED —
  // the two were previously conflated into one PaymentStatus field.
  quotationStatus QuotationStatus @default(DRAFT)
  status          PaymentStatus   @default(PENDING)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdBy       String?
  updatedBy       String?
  isDeleted       Boolean         @default(false)
  version         Int             @default(1)

  projectId String
  project   Project         @relation(fields: [projectId], references: [id])
  items     QuotationItem[]

  @@index([quotationNumber])
  @@index([projectId])
  @@index([status])
  @@index([createdAt])
}

model QuotationItem {
  id          String   @id @default(uuid())
  description String
  unit        String
  quantity    Float
  unitRate    Float
  amount      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean  @default(false)
  version     Int      @default(1)

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model Workflow {
  id          String         @id @default(uuid())
  name        String
  description String?
  status      WorkflowStatus @default(DRAFT)
  currentStep Int            @default(1)
  totalSteps  Int            @default(1)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean        @default(false)
  version     Int            @default(1)

  projectId String
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  steps     WorkflowStep[]

  @@index([projectId])
  @@index([status])
}

model WorkflowStep {
  id          String     @id @default(uuid())
  stepNumber  Int
  name        String
  description String?
  status      TaskStatus @default(TODO)
  comments    String?
  completedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean    @default(false)
  version     Int        @default(1)

  workflowId   String
  workflow     Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  assignedToId String?
  assignedTo   User?    @relation("WorkflowStepAssignee", fields: [assignedToId], references: [id])

  @@index([workflowId])
  @@index([assignedToId])
  @@index([status])
}

model Approval {
  id          String         @id @default(uuid())
  entityType  String
  entityId    String
  status      ApprovalStatus @default(PENDING)
  comments    String?
  requestedAt DateTime       @default(now())
  respondedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean        @default(false)
  version     Int            @default(1)

  requestedById String
  requestedBy   User    @relation("ApprovalRequester", fields: [requestedById], references: [id])
  approvedById  String?
  approvedBy    User?   @relation("ApprovalApprover", fields: [approvedById], references: [id])

  @@index([entityType, entityId])
  @@index([requestedById])
  @@index([approvedById])
  @@index([status])
}

model DigitalSignature {
  id            String   @id @default(uuid())
  entityType    String
  entityId      String
  signatureData String   @db.Text
  signedAt      DateTime @default(now())
  ipAddress     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdBy     String?
  updatedBy     String?
  isDeleted     Boolean  @default(false)
  version       Int      @default(1)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
}

model Notification {
  id         String           @id @default(uuid())
  title      String
  message    String
  type       NotificationType @default(INFO)
  isRead     Boolean          @default(false)
  entityType String?
  entityId   String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  createdBy  String?
  updatedBy  String?
  isDeleted  Boolean          @default(false)
  version    Int              @default(1)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@index([createdAt])
}

model EmailLog {
  id        String    @id @default(uuid())
  to        String
  from      String
  subject   String
  body      String    @db.Text
  status    String
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  version   Int       @default(1)

  @@index([to])
  @@index([status])
  @@index([sentAt])
}

model WhatsAppLog {
  id        String    @id @default(uuid())
  to        String
  from      String
  message   String    @db.Text
  status    String
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  isDeleted Boolean   @default(false)
  version   Int       @default(1)

  @@index([to])
  @@index([status])
  @@index([sentAt])
}

model Report {
  id          String   @id @default(uuid())
  title       String
  content     Json?
  type        String?
  format      String?
  fileUrl     String?
  generatedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean  @default(false)
  version     Int      @default(1)

  projectId     String
  project       Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  generatedById String
  generatedBy   User    @relation("ReportGenerator", fields: [generatedById], references: [id])

  @@index([projectId])
  @@index([generatedById])
  @@index([type])
  @@index([generatedAt])
}

model Document {
  id          String       @id @default(uuid())
  title       String
  description String?
  type        DocumentType @default(OTHER)
  fileUrl     String
  filename    String
  fileSize    Int?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  createdBy   String?
  updatedBy   String?
  isDeleted   Boolean      @default(false)
  version     Int          @default(1)

  projectId    String
  project      Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedById String
  uploadedBy   User    @relation("DocumentUploader", fields: [uploadedById], references: [id])

  @@index([projectId])
  @@index([uploadedById])
  @@index([type])
  @@index([createdAt])
}

model AuditLog {
  id         String       @id @default(uuid())
  action     ActivityType
  entityType String
  entityId   String
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  createdBy  String?
  updatedBy  String?
  isDeleted  Boolean      @default(false)
  version    Int          @default(1)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

